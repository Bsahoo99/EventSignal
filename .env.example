# Copy to .env.local for local owner use. Never commit .env.local.
GEMINI_API_KEY=
# Optional automatic company website discovery. Keep this key server-side.
TAVILY_API_KEY=
EVENTSIGNAL_SEARCH_CACHE=.local/search-cache.sqlite
# Generate with: openssl rand -hex 32
EVENTSIGNAL_OWNER_TOKEN=
# Persistent local filesystem only. Never place this ledger under public/.
EVENTSIGNAL_LEDGER=.local/budget.sqlite
